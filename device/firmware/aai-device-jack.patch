+// ---- studio-published agents: a session ticket per connect ----
+// A published aai agent admits a session only with a short-lived ticket. Configured as its
+// https:// URL, the device asks GET <url>/client-config (public) for the sandbox's sessionUrl
+// and a sessionToken, then connects there with ?token=. A ws:// (local `aai dev`) needs none.
+#define TICKET_URL_MAX   256
+#define TICKET_TOKEN_MAX 768
+static char s_ticket_url[TICKET_URL_MAX];
+static char s_ticket_token[TICKET_TOKEN_MAX];
+
+static bool agent_is_published(const char *base) { return strncmp(base, "https://", 8) == 0; }
+
+static bool fetch_ticket(const char *base)
+{
+    char url[DISCOVERY_URL_MAX + 16];
+    size_t n = strlen(base);
+    snprintf(url, sizeof(url), "%.*s/client-config", (int)(n && base[n - 1] == '/' ? n - 1 : n), base);
+    esp_http_client_config_t cfg = {
+        .url = url,
+        .timeout_ms = 12000,  // a sandbox waking from idle answers slowly
+        .crt_bundle_attach = esp_crt_bundle_attach,
+    };
+    esp_http_client_handle_t h = esp_http_client_init(&cfg);
+    if (!h) return false;
+    bool ok = false;
+    char *body = heap_caps_calloc(1, 4096, MALLOC_CAP_SPIRAM);
+    if (body && esp_http_client_open(h, 0) == ESP_OK) {
+        esp_http_client_fetch_headers(h);
+        int status = esp_http_client_get_status_code(h);
+        int got = 0, r;
+        while (got < 4095 && (r = esp_http_client_read(h, body + got, 4095 - got)) > 0) got += r;
+        body[got] = 0;
+        cJSON *j = status == 200 ? cJSON_Parse(body) : NULL;
+        const char *su = j ? cJSON_GetStringValue(cJSON_GetObjectItem(j, "sessionUrl")) : NULL;
+        const char *tk = j ? cJSON_GetStringValue(cJSON_GetObjectItem(j, "sessionToken")) : NULL;
+        if (su && tk && strlen(su) < sizeof(s_ticket_url) && strlen(tk) < sizeof(s_ticket_token)) {
+            strlcpy(s_ticket_url, su, sizeof(s_ticket_url));
+            strlcpy(s_ticket_token, tk, sizeof(s_ticket_token));
+            ok = true;
+        } else {
+            ESP_LOGE(TAG, "client-config: HTTP %d, no usable sessionUrl/sessionToken", status);
+        }
+        cJSON_Delete(j);
+    } else {
+        ESP_LOGE(TAG, "client-config: could not reach %s", url);
+    }
+    free(body);
+    esp_http_client_cleanup(h);
+    return ok;
+}
