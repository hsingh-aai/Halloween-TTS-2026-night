diff --git a/firmware/components/aai_device/voice.c b/firmware/components/aai_device/voice.c
index 3a6f122..7e26c58 100644
--- a/firmware/components/aai_device/voice.c
+++ b/firmware/components/aai_device/voice.c
@@ -2,10 +2,14 @@
 
 #include <assert.h>
 #include <stdatomic.h>
+#include <string.h>
 #include "aai_events.h"
 #include "agent.h"
 #include "board.h"
 #include "esp_afe_sr_models.h"
+#include "esp_mn_iface.h"
+#include "esp_mn_models.h"
+#include "esp_mn_speech_commands.h"
 #include "esp_heap_caps.h"
 #include "esp_log.h"
 #include "esp_timer.h"
@@ -17,10 +21,100 @@
 static const char *TAG = "voice";
 
 static const esp_afe_sr_iface_t *s_afe;
+static char s_afe_wn_name[32] = "wakenet";
 static esp_afe_sr_data_t *s_afe_data;
 static voice_source_t s_source;
 static atomic_bool s_streaming;
 
+// Wake PHRASES (CONFIG_AAI_WAKE_PHRASES, e.g. "hi jack;hey jack"): MultiNet English speech
+// commands, recognised from text with no training, running beside WakeNet while idle. A
+// trained WakeNet word is more robust; this is for names WakeNet has no model for.
+static const esp_mn_iface_t *s_mn;
+static model_iface_data_t *s_mn_data;
+static int16_t *s_mn_buf;
+static int s_mn_chunk, s_mn_fill;
+static srmodel_list_t *s_models;
+static char *s_mn_name;
+static int64_t s_mn_hold_until_us;  // after a wake, stay unloaded until streaming has had time to start
+
+static void phrases_unload(void);
+
+static void wake(const char *what)
+{
+    phrases_unload();  // free its RAM before the connect, not after
+    s_mn_hold_until_us = esp_timer_get_time() + 10 * 1000000LL;
+    int64_t detected_us = esp_timer_get_time();
+    ESP_LOGI(TAG, "wake word detected (%s)", what);
+    aai_events_post(AAI_EVENT_WAKE, &detected_us, sizeof(detected_us));
+}
+
+// Loaded only while idle and unloaded for a conversation: MultiNet takes internal RAM the
+// Wi-Fi stack needs to stream audio (with it resident, sends stalled and sessions dropped).
+static void phrases_load(void)
+{
+    s_mn = esp_mn_handle_from_name(s_mn_name);
+    s_mn_data = s_mn->create(s_mn_name, 3000);
+    esp_mn_commands_alloc(s_mn, s_mn_data);
+    char buf[128];
+    strlcpy(buf, CONFIG_AAI_WAKE_PHRASES, sizeof(buf));
+    int id = 1;
+    for (char *save = NULL, *tok = strtok_r(buf, ";", &save); tok; tok = strtok_r(NULL, ";", &save)) {
+        esp_mn_commands_add(id++, tok);
+    }
+    esp_mn_error_t *err = esp_mn_commands_update();
+    if (err && err->num > 0) ESP_LOGW(TAG, "%d wake phrase(s) rejected by MultiNet", err->num);
+    s_mn_chunk = s_mn->get_samp_chunksize(s_mn_data);
+    if (!s_mn_buf) s_mn_buf = heap_caps_malloc(s_mn_chunk * sizeof(int16_t), MALLOC_CAP_SPIRAM);
+    s_mn_fill = 0;
+}
+
+static void phrases_unload(void)
+{
+    if (!s_mn) return;
+    esp_mn_commands_free();
+    s_mn->destroy(s_mn_data);
+    s_mn = NULL;
+    s_mn_data = NULL;
+}
+
+static void phrases_init(srmodel_list_t *models)
+{
+    if (!CONFIG_AAI_WAKE_PHRASES[0]) return;
+    s_models = models;
+    s_mn_name = esp_srmodel_filter(models, ESP_MN_PREFIX, ESP_MN_ENGLISH);
+    if (!s_mn_name) {
+        ESP_LOGW(TAG, "wake phrases set but no English MultiNet model is built in (CONFIG_SR_MN_EN_*)");
+        return;
+    }
+    phrases_load();
+    ESP_LOGI(TAG, "wake phrases \"%s\" on %s", CONFIG_AAI_WAKE_PHRASES, s_mn_name);
+}
+
+// Feed processed audio to MultiNet in its own chunk size; only while idle, so Jack saying
+// his own name mid-reply can't wake (and interrupt) him.
+static void phrases_feed(const int16_t *pcm, size_t samples)
+{
+    if (!s_mn) return;
+    while (samples) {
+        size_t n = s_mn_chunk - s_mn_fill;
+        if (n > samples) n = samples;
+        memcpy(s_mn_buf + s_mn_fill, pcm, n * sizeof(int16_t));
+        s_mn_fill += n, pcm += n, samples -= n;
+        if (s_mn_fill < s_mn_chunk) break;
+        s_mn_fill = 0;
+        esp_mn_state_t st = s_mn->detect(s_mn_data, s_mn_buf);
+        if (st == ESP_MN_STATE_DETECTED) {
+            esp_mn_results_t *r = s_mn->get_results(s_mn_data);
+            char heard[32];
+            strlcpy(heard, esp_mn_commands_get_string(r->command_id[0]), sizeof(heard));
+            wake(heard);  // unloads MultiNet
+            return;
+        } else if (st == ESP_MN_STATE_TIMEOUT) {
+            s_mn->clean(s_mn_data);  // keep listening: there is no "after the wake word" here
+        }
+    }
+}
+
